# A deploy-szkriptek helyi beállításai (ADR 0052 D11).
#
# Másold le deploy/deploy.env néven, és töltsd ki. A deploy.env a
# .gitignore-ban van: soha ne kerüljön a repóba. Titok nincs benne, de a
# VPS címe és a kulcsok útvonala nem tartozik a publikus repóra.

# A web domainje; ebből lesz a szerver --origin-je (https://<domain>).
FORETACK_DOMAIN=archivum.example.hu

# A VPS SSH-címe (IP vagy név) és az admin felhasználó (bootstrap.sh).
VPS_HOST=203.0.113.10
VPS_USER=akos

# Az admin SSH-kulcsa a fejlesztői gépen.
VPS_SSH_KEY="$HOME/.ssh/foretack_vps"

# A mentés-lehúzó korlátozott kulcsa (csak olvas, D7).
PULL_USER=foretack-pull
PULL_SSH_KEY="$HOME/.ssh/foretack_backup_pull"

# Ide húzza le a mentéseket a user-timer; 7 napot tart meg.
BACKUP_DIR="$HOME/Documents/develop/hajo/backup/vps"
